#!/bin/sh
# Mount the FAT boot partition (holds streamdeck/config.json) at /boot.
case "$1" in
start|"")
	grep -q " /boot " /proc/mounts && exit 0
	for dev in /dev/mmcblk0p1 /dev/sda1 /dev/nvme0n1p1 /dev/vda1; do
		[ -b "$dev" ] || continue
		mount -t vfat -o rw,noatime,flush "$dev" /boot 2>/dev/null && { echo "Mounted $dev on /boot"; exit 0; }
	done
	echo "No boot partition found; using /etc/streamdeck/config.json"
	;;
stop)
	sync; umount /boot 2>/dev/null
	;;
esac
exit 0
