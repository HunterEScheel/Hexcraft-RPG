#!/bin/sh
# Live USB: mount the installer media at /media/live.
# Installed: mount the STREAMDECK EFI partition at /boot and keep settings
# (secrets, Wi-Fi) in /boot/streamdeck/state.
[ "$1" = stop ] && { sync; umount /boot 2>/dev/null; exit 0; }
find_label() {
	for i in $(seq 1 20); do
		dev=$(findfs "LABEL=$1" 2>/dev/null) && { echo "$dev"; return 0; }
		sleep 1; mdev -s
	done
	return 1
}
if grep -q streamdeck.live /proc/cmdline; then
	if dev=$(/usr/sbin/find-live-media 20); then
		echo "Live media: $dev"
	else
		echo "Live media not found yet (the installer will look again)"
	fi
else
	# Repair the FAT first in case power was cut while saving, then mount
	# with synchronous writes so a later power cut can't lose a saved change.
	if dev=$(find_label STREAMDECK) && { fsck.fat -a -w "$dev" >/dev/null 2>&1; true; } &&
		mount -t vfat -o rw,noatime,sync,dirsync "$dev" /boot; then
		mkdir -p /boot/streamdeck/state
		rm -rf /var/lib/streamdeck
		ln -s /boot/streamdeck/state /var/lib/streamdeck
		echo "System disk: $dev"
	else
		echo "STREAMDECK partition not found; settings will not be saved"
	fi
fi
exit 0
