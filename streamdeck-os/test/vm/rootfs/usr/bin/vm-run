#!/bin/sh
# Point streamdeckd at the in-VM mock APIs instead of Govee/Spotify.
export STREAMDECKD_GOVEE_URL=http://127.0.0.1:9999/govee
export STREAMDECKD_SPOTIFY_API_URL=http://127.0.0.1:9999/spotify/api
export STREAMDECKD_SPOTIFY_TOKEN_URL=http://127.0.0.1:9999/spotify/token
export STREAMDECKD_SPOTIFY_AUTH_URL=http://127.0.0.1:9999/spotify/authorize
export STREAMDECKD_TRACE=/dev/ttyS1
export STREAMDECKD_WIFI_RESTART=true
case "$1" in
console) exec /usr/bin/streamdeckd console ;;
daemon)
	/usr/bin/streamdeckd run > /dev/ttyS1 2>&1
	sleep 2 ;;
esac
