# Copy to .env.local and fill in from your Supabase project settings (API section)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only: used by `npm run embeddings` (scripts/generate-hexcraft-embeddings.mjs).
# Never prefix these with VITE_ and never commit real values — the service role key
# bypasses row-level security.
# OPENAI_API_KEY=
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
